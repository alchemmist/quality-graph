{
  "$defs": {
    "label": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "minLength": 0,
          "pattern": "^[0-9a-fA-F]{6}$",
          "type": "string"
        },
        "create": {
          "type": "boolean"
        },
        "description": {
          "maxLength": 100,
          "minLength": 0,
          "type": "string"
        },
        "name": {
          "maxLength": 50,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "node": {
      "additionalProperties": false,
      "oneOf": [
        {
          "not": {
            "required": [
              "uses"
            ]
          },
          "required": [
            "run"
          ]
        },
        {
          "not": {
            "required": [
              "run"
            ]
          },
          "required": [
            "uses"
          ]
        }
      ],
      "properties": {
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "label": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "maxLength": 50,
              "minLength": 1,
              "type": "string"
            },
            {
              "$ref": "#/$defs/label"
            }
          ]
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "needs": {
          "items": {
            "minLength": 0,
            "pattern": "^[a-z][a-z0-9-]{0,62}$",
            "type": "string"
          },
          "maxItems": 1000,
          "type": "array"
        },
        "policy": {
          "additionalProperties": false,
          "properties": {
            "approvals": {
              "additionalProperties": false,
              "properties": {
                "files": {
                  "type": "boolean"
                },
                "findings": {
                  "type": "boolean"
                },
                "node": {
                  "type": "boolean"
                }
              },
              "required": [],
              "type": "object"
            },
            "blocking": {
              "type": "boolean"
            },
            "blocking-severities": {
              "items": {
                "enum": [
                  "notice",
                  "warning",
                  "error"
                ]
              },
              "maxItems": 3,
              "type": "array"
            }
          },
          "required": [],
          "type": "object"
        },
        "profile": {
          "minLength": 0,
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "type": "string"
        },
        "results": {
          "additionalProperties": false,
          "maxProperties": 1,
          "minProperties": 1,
          "properties": {
            "exit-code": {
              "type": "null"
            },
            "junit": {
              "minLength": 1,
              "type": "string"
            },
            "native": {
              "minLength": 1,
              "type": "string"
            },
            "sarif": {
              "minLength": 1,
              "type": "string"
            }
          },
          "type": "object"
        },
        "run": {
          "minLength": 1,
          "type": "string"
        },
        "shell": {
          "minLength": 1,
          "type": "string"
        },
        "timeout-minutes": {
          "maximum": 360,
          "minimum": 1,
          "type": "integer"
        },
        "title": {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        "uses": {
          "minLength": 1,
          "type": "string"
        },
        "with": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "working-directory": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "profile": {
      "additionalProperties": false,
      "properties": {
        "container": {
          "minLength": 1,
          "type": "string"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "extends": {
          "minLength": 0,
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "type": "string"
        },
        "permissions": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "runner": {
          "minLength": 1,
          "type": "string"
        },
        "services": {
          "type": "object"
        },
        "setup": {
          "items": {
            "$ref": "#/$defs/step"
          },
          "maxItems": 100,
          "type": "array"
        },
        "timeout-minutes": {
          "maximum": 360,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    },
    "step": {
      "additionalProperties": false,
      "oneOf": [
        {
          "not": {
            "required": [
              "uses"
            ]
          },
          "required": [
            "run"
          ]
        },
        {
          "not": {
            "required": [
              "run"
            ]
          },
          "required": [
            "uses"
          ]
        }
      ],
      "properties": {
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "run": {
          "minLength": 1,
          "type": "string"
        },
        "shell": {
          "minLength": 1,
          "type": "string"
        },
        "uses": {
          "minLength": 1,
          "type": "string"
        },
        "with": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "working-directory": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    }
  },
  "$id": "https://github.com/alchemmist/quality-graph/blob/main/schemas/graph-v0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "administration": {
      "additionalProperties": false,
      "properties": {
        "roles": {
          "items": {
            "enum": [
              "admin",
              "maintain",
              "write"
            ]
          },
          "maxItems": 3,
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    },
    "labels": {
      "additionalProperties": false,
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "failing": {
          "oneOf": [
            {
              "maxLength": 50,
              "minLength": 1,
              "type": "string"
            },
            {
              "$ref": "#/$defs/label"
            }
          ]
        }
      },
      "required": [],
      "then": {
        "required": [
          "failing"
        ]
      },
      "type": "object"
    },
    "nodes": {
      "additionalProperties": {
        "$ref": "#/$defs/node"
      },
      "minProperties": 1,
      "propertyNames": {
        "minLength": 0,
        "pattern": "^[a-z][a-z0-9-]{0,62}$",
        "type": "string"
      },
      "type": "object"
    },
    "profiles": {
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      },
      "propertyNames": {
        "minLength": 0,
        "pattern": "^[a-z][a-z0-9-]{0,62}$",
        "type": "string"
      },
      "required": [
        "default"
      ],
      "type": "object"
    },
    "provider": {
      "oneOf": [
        {
          "minLength": 0,
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "configuration": {
              "additionalProperties": true,
              "properties": {
                "default-branch": {
                  "maxLength": 255,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "type": "object"
            },
            "name": {
              "minLength": 0,
              "pattern": "^[a-z][a-z0-9-]{0,62}$",
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        }
      ]
    },
    "runtime": {
      "type": "object"
    },
    "version": {
      "const": 0
    }
  },
  "required": [
    "version",
    "profiles",
    "nodes"
  ],
  "title": "Quality Graph Declaration v0",
  "type": "object"
}
